# ===== Wajib diisi =====
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# ID Telegram yang boleh memakai bot (pisahkan dengan koma). Lihat /id di bot.
TELEGRAM_ALLOWED_USER_IDS=
# Kunci API. Generate: openssl rand -hex 32
API_KEY=ganti-dengan-hasil-openssl-rand-hex-32

# ===== Server =====
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
CONFIG_DIR=./config/sources
LOG_LEVEL=info
TIMEZONE=Asia/Jakarta
# Set true jika API diakses lewat reverse proxy (Caddy/Nginx) agar rate limit memakai IP asli.
TRUST_PROXY=false

# ===== Bot =====
# auto = webhook jika PUBLIC_URL diisi, kalau tidak polling
BOT_MODE=auto
# Wajib untuk webhook, contoh: https://scraper.domainmu.com
PUBLIC_URL=
WEBHOOK_PATH=/telegram/webhook
# Kosongkan = dibuat otomatis (acak) setiap start
WEBHOOK_SECRET=

# ===== Scraper =====
DEFAULT_USER_AGENT=TelegramScraperBot/1.0 (+https://example.com/kontak)
RESPECT_ROBOTS=true
ALLOW_ADHOC=true
JOB_CONCURRENCY=2
JOB_TIMEOUT_MS=120000
MAX_QUEUE=50
MAX_RESULT_BYTES=10485760
MAX_ITEMS=500

# ===== Security / Bug Bounty =====
# Aktifkan scanner. Scan tetap butuh scope + konfirmasi otorisasi.
SECURITY_ENABLED=true
# WAJIB: domain yang kamu punya IZIN TERTULIS untuk diuji (pisah koma).
# example.com mencakup subdomain; *.example.com hanya subdomain.
SECURITY_ALLOWED_DOMAINS=
SECURITY_RATE_LIMIT=20
SECURITY_MAX_ACTIVE_SCANS=1
SECURITY_MAX_QUEUE=10
SECURITY_COOLDOWN_SECONDS=60
SECURITY_SCAN_TIMEOUT_MS=900000
SECURITY_TOOL_TIMEOUT_MS=120000
SECURITY_NUCLEI_TIMEOUT_MS=600000
SECURITY_SQLMAP_TIMEOUT_MS=180000
SECURITY_MAX_FINDINGS=200
SECURITY_MAX_PARAM_URLS=50
SECURITY_DALFOX_MAX_URLS=10
SECURITY_SQLMAP_MAX_URLS=5
SECURITY_SUBFINDER_LIMIT=50
SECURITY_NUCLEI_SEVERITY=critical,high,medium,low,info
SECURITY_NUCLEI_EXCLUDE_TAGS=dos,fuzz,intrusive,brute-force,credential-stuffing
# Kosongkan = deteksi otomatis (/opt/nuclei-templates atau ~/nuclei-templates).
SECURITY_NUCLEI_TEMPLATES=
# Kosongkan = pakai DEFAULT_USER_AGENT.
SECURITY_USER_AGENT=

# Override path binary bila tool tidak ada di PATH / nama berbeda.
# PENTING: httpx harus ProjectDiscovery httpx, bukan package Python "httpx".
SECURITY_NUCLEI_BIN=nuclei
SECURITY_HTTPX_BIN=httpx
SECURITY_KATANA_BIN=katana
SECURITY_SUBFINDER_BIN=subfinder
SECURITY_DALFOX_BIN=dalfox
SECURITY_SQLMAP_BIN=sqlmap
SECURITY_PARAMSPIDER_BIN=paramspider

# Pengiriman laporan ke target (NONAKTIF default, mencegah spam).
# Aktifkan hanya jika kamu berwenang menghubungi target.
SECURITY_REPORT_SEND=false
SECURITY_REPORT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== Docker Compose: profil webhook =====
# Domain untuk Caddy (DNS A record harus mengarah ke VPS). Kosong = localhost.
DOMAIN=
